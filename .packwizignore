# ============================================================
#  .packwizignore  —  qué NO entra en el índice del modpack
#  Sintaxis idéntica a .gitignore.
#
#  Se distribuyen SOLO: mods/ erdm-defaults/ resourcepacks/
#                       shaderpacks/ emotes/
#  Todo lo demás se excluye explícitamente aquí abajo.
#  (No se puede usar "/*" + excepciones: packwiz aplica la regla
#   gitignore de que no se readmite nada dentro de una carpeta
#   ya excluida, y el índice sale vacío.)
# ============================================================

# config/ YA NO se indexa directamente (cambio del 13-sep-2026): es
# el mecanismo que pisaba la configuración del jugador en cada sync.
# Lo que se indexa es erdm-defaults/config/, una copia congelada que
# el propio erdm-launcher.ps1 del jugador usa para sembrar su config/
# local sin pisar lo que ya personalizó. Ver erdm-clasificacion.toml
# y poblar-defaults.ps1.
/config/

# --- Metadatos internos de Prism Launcher ---
# Prism escribe sus propios .pw.toml aquí, en formato packwiz pero en
# una subcarpeta. Si se indexan desde ahí, packwiz-installer descarga
# los .jar a "mods/.index/" en vez de a "mods/" (resuelve el destino
# como hermano del metafile) y el juego arranca SIN NINGÚN MOD.
# Los metafiles buenos viven en "mods/"; esta carpeta es solo de Prism.
# El script actualizar-pack.ps1 sincroniza una hacia la otra.
/mods/.index/

# --- Binarios de mods/packs: NO van al repo ---
# Los 57 archivos existen en Modrinth, así que packwiz guarda solo
# un .pw.toml por archivo (~400 bytes) y cada jugador lo baja de
# Modrinth. Sin esto el repo pesaría 115 MB en vez de ~1 MB.
/mods/*.jar
/mods/*.jar.disabled
/resourcepacks/*.zip
/shaderpacks/*.zip

# Ajustes personales de shader (BLOOM, TAA, etc. — igual que
# iris.properties): cada jugador genera el suyo, no se distribuye.
/shaderpacks/*.zip.txt

# --- Excepciones: jars que NO existen en Modrinth (o sin build para MC 26.2) ---
# Estos cuatro si viajan en el repo como archivo suelto (sin metafile),
# porque no hay de donde bajarlos. (desktoptooltips también viaja en el
# repo, pero SÍ tiene metafile — su excepción está más abajo, en su
# propio bloque, y NO lleva línea aquí para no indexarlo dos veces.)
#
#   itemswapper...4e23d0f...dirty : build propio. El de Modrinth
#     (git.518b04a) declara el entrypoint 'controlify' en su
#     fabric.mod.json pero NO incluye la clase
#     dev.tr7zw.itemswapper.compat.ControlifyItemswapperEntrypoint,
#     asi que crashea con ClassNotFoundException en cuanto el jugador
#     tenga Controlify instalado. Este build si la trae.
#
#   erdmdodge : mod propio del dash local. No esta publicado en ningun
#     sitio. Quien no lo tenga sigue teniendo dash, calculado en el
#     servidor; el plugin distingue los dos casos por si solo.
!/mods/itemswapperfabric*.jar
!/mods/erdmdodge-*.jar

#   hoofprint : "Hoofprint Samukis Edition" segun su propio
#     fabric.mod.json. No es el build oficial: es un fork/parche
#     propio. Ademas Modrinth no tiene NINGUNA version de hoofprint
#     para Minecraft 26.2 (comprobado contra la API, lista vacia),
#     asi que aunque quisieramos el oficial no existe.
#
#   surveyor : su fabric.mod.json es el estandar (sin marca propia),
#     pero Modrinth tampoco tiene NINGUNA version para MC 26.2.
#     hoofprint depende de "surveyor >=1.2.4+26.2", asi que este
#     jar es forzosamente un build no publicado (de fuente o de un
#     artifact de CI). Sin el, hoofprint no arranca.
#
#   desktoptooltips : mod propio (leyenda de teclas sobre el HUD,
#     estilo Fortnite). No esta publicado en ningun sitio.
#     Solo va en Graficos Sofisticados (rama "sofisticado").
#
#   spyglass_improvements...erdm.1 : fork propio ("Spyglass Improvements
#     XVaults", de juancarloscp52) para que el zoom del catalejo funcione
#     tambien guardado en shulker/ender chest/vault via ItemSwapperXVaults.
#     Obligatorio en ambos perfiles, confirmado por Samukis.
#
#   erdmlauncherui : mod propio de ERDM (boton "ERDM..." en la pantalla
#     de Opciones -> elegir version del modpack / sobrescribir config).
#     No esta publicado en ningun sitio. Va en las DOS ramas: es el
#     propio mecanismo para cambiar de version, asi que no puede faltar
#     en ninguna. Compilado y probado el 13-sep-2026
#     (ver ERDM_Server de Desarrollo/Development/ErdmLauncherUIMod).
!/mods/hoofprint-*.jar
!/mods/surveyor*.jar
!/mods/spyglass_improvements-*.jar
!/mods/erdmlauncherui-*.jar

# desktoptooltips-1.0.0.jar NO lleva excepción aquí (aunque sí en
# .gitignore): tiene metafile propio (mods/desktop-tooltips.pw.toml,
# mode="url") que ya lo referencia. Si además se indexa como archivo
# suelto, packwiz lo distribuye DOS veces.

#   Visual Shulker Labels : puerto propio a pack_format 88 (MC 26.2).
#     El oficial de Modrinth (G5qVDE0L) solo llega a pack_format 64
#     (hasta 1.21.8); no es intercambiable con ese download.
!/resourcepacks/Visual Shulker Labels.zip

